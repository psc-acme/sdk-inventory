{
    "name": "psc-acme/sdk-inventory",
    "description": "Package sdk-inventory for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\SdkInventory\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "doctrine/doctrine-bundle": "^2.13",
        "brick/math": "^0.12",
        "league/commonmark": "^2.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "vimeo/psalm": "^5.0",
        "webforge/object-asserter": "^2.0.0"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}